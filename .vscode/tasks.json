{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "[Compile]",
            "windows": {
                "command": "./Makefile.bat"
            },
            "linux": {
                "command": "make"
            },
            "osx": {
                "command": "make"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "[Run]",
            "windows": {
                "command": "./Makefile.bat",
                "args": ["-r"]
            },
            "linux": {
                "command": "make",
                "args": ["run"]
            },
            "osx": {
                "command": "make",
                "args": ["run"]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "[Compile & Run]",
            "windows": {
                "command": "./Makefile.bat",
                "args": ["-cr"]
            },
            "linux": {
                "command": "make",
                "args": ["run"]
            },
            "osx": {
                "command": "make",
                "args": ["run"]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "[Clean]",
            "windows": {
                "command": "./Makefile.bat",
                "args": ["-c"]
            },
            "linux": {
                "command": "make",
                "args": ["clean"]
            },
            "osx": {
                "command": "make",
                "args": ["clean"]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ]
}